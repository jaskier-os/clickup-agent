# ClickUp personal API token (pk_...). Required. Get one from ClickUp -> Settings -> Apps.
CLICKUP_API_KEY=

# MCP tool server listen port.
MCP_PORT=10016
# URL the agent uses to reach the MCP server (usually localhost on MCP_PORT).
MCP_URL=http://localhost:10016

# Orchestrator WebSocket URL the agent connects to. Use wss:// to enable TLS.
ORCHESTRATOR_URL=ws://localhost:10001
# Communicator (LLM gateway) base URL.
COMMUNICATOR_URL=http://localhost:10000
# API key passed to the orchestrator/communicator. Leave blank if not enforced.
API_KEY=
# Model name passed to the communicator (e.g. sonnet).
MODEL=sonnet
# Health endpoint port for the agent. 0 disables the health server.
HEALTH_PORT=10012

# Optional: path to a CA cert (PEM) for TLS to the orchestrator when using wss://.
# If unset or missing, the agent connects without a custom CA (plain ws:// works without this).
# NODE_EXTRA_CA_CERTS=

# Optional: outbound HTTP/HTTPS proxy for ClickUp/communicator calls.
# Leave unset for a direct connection.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=
